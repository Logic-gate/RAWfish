; rawfish-ir.conf.example -- every key of ~/.config/com.rawfish/rawfish-ir/rawfish-ir.conf,
; with what it does, its values and its limits. Written by RAWfish-ir at each start
; next to the real file (this copy is refreshed). The real file lists every
; setting, even at its default: when there is none (a new install, or after
; "Reset the camera settings") it is created from this one; a key it lacks
; (an older file, a key a new version adds) is added at its default, the
; values already there untouched; a key of an older version that nothing
; reads any more is dropped.
;
; Back to the defaults: Settings > Apps > RAWfish-ir > "Reset the camera settings"
; (the file is kept as rawfish-ir.conf.bak), or delete the file with the app closed.
;
; How to edit the real file: CLOSE the app first (it rewrites the file when a
; setting changes, and drops any comment), edit, reopen. A value out of its
; range is clamped, a value not in its list falls back to the default: a typo
; never stops the app. Keys are under [General].
;
; Settings NOT in this file (dconf, from Settings > Apps > RAWfish-ir):
;   /apps/rawfish-ir/menu/startMode     last | simple | advanced   mode at start
;   /apps/rawfish-ir/menu/startManual   true | false               start in manual focus + exposure
;   /apps/rawfish-ir/menu/showScenes    true | false               scenes in the camera menu
;   output folders and file prefix (the [output] settings of the Settings page)

[General]

; --- The camera menu ------------------------------------------------------
; Self-timer before a shot, seconds.            values: 0, 3, 10        default 0
timerSec=0
; Image proportion of the JPEG ("" = the sensor's own, 4:3 on most phones).
;                                               values: "", 4:3, 16:9   default ""
format=
; JPEG size, WIDTHxHEIGHT among the sizes the camera lists ("" = the largest).
;                                               e.g. 4096x3072          default ""
captureSize=
; JPEG quality (JPG and HAL JPG).
;                                 values: 20, 40, 60, 80, 90, 95, 100   default 95
jpegQuality=95
; White-balance preset: 1 auto, 2 incandescent, 3 fluorescent, 4 warm fluorescent,
; 5 daylight, 6 cloudy, 7 twilight, 8 shade (only those the camera lists).
;                                               range 1..8              default 1
awbMode=1
; Bracketing: off; 0 = three shots at the same exposure (x3); 1, 2, 3 = three
; shots at -N, 0, +N stops.                     values: off, 0, 1, 2, 3 default off
bracket=off
; Rule-of-thirds grid.                          values: 0, 1            default 0
gridOn=0
; Zebra and focus peaking as last left, restored at the start in advanced
; mode (simple mode starts without them).      values: 0, 1            default 0
zebraOn=0
peakingOn=0
; Mode last used (simple 0, advanced 1); read when "Mode at start" is "last".
; A new install opens in simple mode.
;                                               values: 0, 1            default 0
advanced=0
; Scene mode (Camera2 number; 0 off). Used only when the scenes are shown.
;                                               range 0..18             default 0
sceneMode=0
; Flash.                                        values: off, auto, on, torch   default off
flash=off

; --- Processing (only here, not in the menu) ---------------------------------
; JPG is RAWfish-ir's JPEG: the camera's image before its own noise reduction
; and sharpening (its YUV stream), processed by RAWfish-ir, then compressed.
; Frames taken and merged: less grain, no texture lost, a little more time.
;                                               values: 1, 2, 4         default 1
jpgFrames=1
; Colour noise filter: 0 off, 1..5 = 1, 2, 3, 5, 8 times the measured noise
; (4 and 5 are deliberately too much, to see the effect).
;                                               range 0..5              default 2
jpgNoiseColourFilter=2
; False colour on fine textures (a zipper, a weave): a median on the colour,
; 0 off, 1..4 = 3x3, 5x5, 7x7, 9x9; it also removes real colour dots that small.
;                                               range 0..4              default 0
jpgMoireFilter=0
; RAWfish-ir's sharpening of the fine detail above the noise: 0 off, 1..5 =
; 0.5, 1, 1.5, 2.5, 4 times the detail (4 and 5 deliberately too much).
;                                               range 0..5              default 3
jpgSharpen=3

; The zebra in JPG: luma = a pixel is striped when it comes out white (its
; luminance reaches the level); channel = when any one colour channel does
; (a blue sky or a red folder then stripe long before they look burnt). RAW
; always uses the channel test: one channel lost is data lost.
;                                               values: luma, channel   default luma
zebraJpegMode=luma
; Checks in the log: each photo's report then carries the histogram the app
; showed (viewfinder, or RAW meter) and the photo's own, for histo-check.py.
; About 2 KB of log per photo; off for everyday use. The same switch is in
; Settings > Apps > RAWfish-ir > Log > "Detailed log".
;                                               values: false, true     default false
logChecks=false
; The YUV stream's size for JPG: jpeg = the photo's size, taken through the
; largest listed YUV size that is a whole multiple of it, averaged down (the
; normal case: a mid-size YUV stream makes the JP2's viewfinder lag, the full
; size does not); max = the largest, processed at that size (slow); or a
; WIDTHxHEIGHT the camera lists. A test key.
;                                               values: jpeg, max, WxH  default jpeg
jpgYuvStream=jpeg
; HAL JPG: the camera driver's own JPEG, offered in TYPE when this is true.
; Stacks, brackets and bursts use the HAL JPEG and its settings below even
; when it is not offered. On a phone whose session cannot hold the YUV stream
; (exclusive streams), JPG is the HAL JPEG.
;                                               values: false, true     default false
useHalJpeg=false
; The HAL JPEG's noise reduction.               values: default, off, fast, hq, minimal   default off
halJpegNoise=off
; The HAL JPEG's sharpening.                    values: default, off, fast, hq            default hq
halJpegSharpen=hq
; The viewfinder's noise reduction (the HAL's).  values: default, off, fast, hq, minimal   default fast
viewfinderNoise=fast
; The viewfinder's sharpening (the HAL's).      values: default, off, fast, hq            default off
viewfinderSharpen=off
; Σ stacks: 1 = the stack's own frames; 2 or 4 = that many times more frames,
; divided out (less noise, 2x or 4x the time).  values: 1, 2, 4         default 1
stackDenoise=1

; --- Focus peaking and zebra (no longer in the menu) -----------------------
; A change in % applied to the device's own thresholds (override-hal.json:
; peak_edge, zebra_jpeg, zebra_raw). Negative = more peaking / zebra appears
; earlier; positive = less / later.             values: -30, 0, 30      default 0
peakTweak=0
zebraTweak=0

; --- White balance (the deck's ± and readouts) ------------------------------
; Warmth shift from the white in force, in steps of 5 % on red/blue
; (+ warmer).                                   range -20..20           default 0
wbShift=0
; Tint shift, % of green (- greener, + magenta). range -100..100        default 0
tint=0
; A white measured on a neutral object (the 2 s press on a readout): gains
; "R,Ge,Go,B"; "" = none. At start it is kept only if "Keep previous manual WB"
; is tapped.                                    e.g. 1.8868,1,1,1.4961  default ""
wbFixed=
; Size of one press of the warmth button, in 5 % units.   range 1..4   default 1
fineWarmthStep=1
; Size of one press of the tint button, in % of green.    range 1..25  default 5
fineTintStep=5

; --- Lens shading (vignetting) in the DNG -------------------------------------
; When a measured calibration exists for the phone (one is shipped for the
; Jolla Phone 2), each DNG gets a gain map composed for its own lens position
; and light; these three set how it is applied (darktable applies it).
; Pivot: 0 = only brighten the edges, 100 = only darken towards the darkest
; corner; in between, both. darktable clips values pushed above white, so a
; pivot keeps bright edges from clipping (raise the exposure in darktable).
;                                               range 0..100            default 50
shadingPivot=50
; How much of the correction is applied.        range 0..100            default 100
shadingStrength=100
; The largest gain allowed (more amplifies the corners' noise).
;                                               range 1..8              default 5
shadingMaxGain=5

; --- Σ (stacked long exposures) ------------------------------------------------
; Target frame rate of the Σ viewfinder: one frame of the stack's exposure, as
; short as this allows, the ISO raised to match (slower when the maximum ISO
; is reached).                                  range 1..30 frames/s    default 10
sigmaPreviewFps=10
; Measured by the app after each stack (time the camera adds between
; sub-frames); used for the time estimate under the wheel. Leave it.
;                                               range 0..5000 ms        default 200
frameLatencyMs=200

; --- Kept for "Start in manual focus and exposure" --------------------------
; Saved when the app goes to the background or closes; leave them (absent
; from a new file: the start then takes the automatic values).
; Focus distance in diopters (1/metres; 0 = infinity).   range 0..10
lastFocusD=1
; ISO and shutter (nanoseconds; beyond 500000000 a Σ stack).
lastIso=100
lastShutterNs=16666667
; The level's zero, recorded by holding "level" with the phone upright
; (degrees; empty or absent = the sensor's own zero).
; levelRoll0=0.00
; levelPitch0=0.00
