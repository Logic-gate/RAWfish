; rawfish-ir.conf.example -- every key of ~/.config/com.rawfish/rawfish-ir/rawfish-ir.conf,
; with what it does, its values and its limits. Written by RAWfish-ir at each start
; next to the real file (this copy is refreshed). The real file lists every
; setting, even at its default: when there is none (a new install, or after
; "Reset the camera settings") it is created from this one; a key it lacks
; (an older file, a key a new version adds) is added at its default, the
; values already there untouched; a key of an older version that nothing
; reads any more is dropped.
;
; Back to the defaults: Settings > Apps > RAWfish-ir > "Reset the camera settings"
; (the file is kept as rawfish-ir.conf.bak), or delete the file with the app closed.
;
; How to edit the real file: CLOSE the app first (it rewrites the file when a
; setting changes, and drops any comment), edit, reopen. A value out of its
; range is clamped, a value not in its list falls back to the default: a typo
; never stops the app. Keys are under [General].
;
; Settings NOT in this file (dconf, from Settings > Apps > RAWfish-ir):
;   /apps/rawfish-ir/menu/startMode     last | simple | advanced   mode at start
;   /apps/rawfish-ir/menu/startManual   true | false               start in manual focus + exposure
;   /apps/rawfish-ir/menu/showScenes    true | false               scenes in the camera menu
;   output folders and file prefix (the [output] settings of the Settings page)

[General]

; --- The camera menu ------------------------------------------------------
; Self-timer before a shot, seconds.            values: 0, 3, 10        default 0
timerSec=0
; Image proportion of the JPEG ("" = the sensor's own, 4:3 on most phones).
;                                               values: "", 4:3, 16:9   default ""
format=
; JPEG size, WIDTHxHEIGHT among the sizes the camera lists ("" = the largest
; of at most 13 megapixels: 4096x3072 on the JP2).
;                                               e.g. 4096x3072          default ""
captureSize=
; Internal: 1 once the 12.5 MP default (0.3.1) has been applied over a size
; stored by an earlier version's default. Not to edit.
sizeDefaultApplied=0
; Internal: the camera ids and their sides (back, front), as the last session
; listed them, for the camera button when no session has opened yet. Not to
; edit (rewritten at each start).
knownCameras=
knownFacing=
; JPEG quality (JPG and HAL JPG).
;                                 values: 20, 40, 60, 80, 90, 95, 100   default 95
jpegQuality=95
; White-balance preset: 1 auto, 2 incandescent, 3 fluorescent, 4 warm fluorescent,
; 5 daylight, 6 cloudy, 7 twilight, 8 shade (only those the camera lists).
; Back to 1 (auto) at each start of the app.
;                                               range 1..8              default 1
awbMode=1
; Bracketing: off; 0 = three shots at the same exposure (x3); 1, 2, 3 = three
; shots at -N, 0, +N stops.                     values: off, 0, 1, 2, 3 default off
bracket=off
; Rule-of-thirds grid.                          values: 0, 1            default 0
gridOn=0
; Zebra and focus peaking as last left, restored at the start in advanced
; mode (simple mode starts without them).      values: 0, 1            default 0
zebraOn=0
peakingOn=0
; Continuous autofocus caught searching at the release (after a reframing):
; the photo waits for the search to end, at most this long, then is taken
; anyway. A lens already settled costs nothing. In milliseconds; 0 = never
; wait. The JP2's searches take 0.4 to 0.95 s.
;                                               values: 0 .. 3000      default 1000
focusScanWait=1000
; Vibration at the release (the press, or the end of the timer), in
; milliseconds; 0 = none.                       values: 0 .. 200       default 40
hapticShutter=40
; Vibration at a change of TYPE, in milliseconds; 0 = none. Below about
; 15 ms the JP2's vibration motor does not move at all.
;                                               values: 0 .. 100       default 20
hapticType=20
; Mode last used (simple 0, advanced 1); read when "Mode at start" is "last".
; A new install opens in simple mode.
;                                               values: 0, 1            default 0
advanced=0
; Scene mode (Camera2 number; 0 off). Used only when the scenes are shown.
;                                               range 0..18             default 0
sceneMode=0
; Flash.                                        values: off, auto, on, torch   default off
flash=off

; --- Processing (only here, not in the menu) ---------------------------------
; JPG is RAWfish-ir's JPEG: the camera's image before its own noise reduction
; and sharpening (its YUV stream), processed by RAWfish-ir, then compressed.
; Frames taken and merged: less grain, no texture lost, a little more time.
;                                               values: 1, 2, 4, 8      default 1
jpgFrames=1
; The merge: classic (each frame shifted whole onto the sharpest) or tiles
; (each part of a frame aligned on its own: for hand-held shots and things
; that move a little). The tile merge has its own frame count, and can take
; each frame shorter (1/2, 1/4 of the pose, the ISO raised to match): less
; blur, the extra noise averaged out by the frames.
;                                               values: classic, tiles  default classic
jpgNrMethod=classic
;                                               values: 2, 4, 8         default 4
jpgTileFrames=4
;                                               values: 1, 2, 4         default 1
jpgTileSplit=1
; Colour noise filter: 0 off, 1..5 = 1, 2, 3, 5, 8 times the measured noise
; (4 and 5 are deliberately too much, to see the effect).
;                                               range 0..5              default 2
jpgNoiseColourFilter=2
; False colour on fine textures (a zipper, a weave): a median on the colour,
; 0 off, 1..4 = 3x3, 5x5, 7x7, 9x9; it also removes real colour dots that small.
;                                               range 0..4              default 0
jpgMoireFilter=0
; RAWfish-ir's luminance noise filter, after the frames are merged and before
; the sharpening: each pixel averaged with its neighbours that differ from it
; by less than 1, 1.5 or 2.2 times the noise measured (1..3), so that grain
; goes and edges stay; 0 off. auto: this camera's default (the device
; profile's luma_nr: 2 on the Xperia 10 III, 0 on the other phones).
;                                               auto, 0..3              default auto
jpgLumaNoiseFilter=auto
; RAWfish-ir's sharpening of the fine detail above the noise: 0 off, 1..5 =
; 0.5, 1, 1.5, 2.5, 4 times the detail (4 and 5 deliberately too much).
;                                               range 0..5              default 3
jpgSharpen=3

; The zebra in JPG: luma = a pixel is striped when it comes out white (its
; luminance reaches the level); channel = when any one colour channel does
; (a blue sky or a red folder then stripe long before they look burnt). In
; RAW this key is not used: the zebra stripes what the RAW meter finds
; clipped in the sensor data (its share, on the viewfinder's brightest
; pixels; zebraTweak shifts it): full stripes where two or three colour
; channels are lost, light (white only) where one alone is -- mostly the
; green, which a RAW developer rebuilds from the two others.
;                                               values: luma, channel   default luma
zebraJpegMode=luma
; The start's peek: the menu comes down a little and goes back up at the
; start, until it has been opened once (then 1). 0 shows the peek again.
;                                               values: 0, 1            default 0
menuDiscovered=0
; Checks in the log: each photo's report then carries the histogram the app
; showed (viewfinder, or RAW meter) and the photo's own, for histo-check.py.
; About 2 KB of log per photo; off for everyday use. Our JPG photos then
; carry their settings in their file names as well (the Gallery's details
; show the name, not the Exif we write):
; photo_tiles4-half_1-48s_iso4428_col2_moire0_sharp3_..._717.jpg. The same switch is in
; Settings > Apps > RAWfish-ir > Log > "Detailed log".
;                                               values: false, true     default false
logChecks=false
; The YUV stream's size for JPG: jpeg = the photo's size, taken through the
; largest listed YUV size that is a whole multiple of it, averaged down (the
; normal case: a mid-size YUV stream makes the JP2's viewfinder lag, the full
; size does not); max = the largest, processed at that size (slow); or a
; WIDTHxHEIGHT the camera lists, which sets the photo's size to that size
; on EVERY camera (a 1280x960 stream makes 1.2 MP photos). A test key.
;                                               values: jpeg, max, WxH  default jpeg
jpgYuvStream=jpeg
; JPG, with jpgYuvStream=jpeg: where the camera lists no YUV stream that is a
; whole multiple of the photo's size (the JP2's selfie camera: its 3264x2448
; photo, and an in-between stream makes its viewfinder lag), take the camera's
; LARGEST stream and average it down by 2 or 4, when it is that many times the
; photo's size within 2 % (3280x2464 photos from its 6560x4928 stream). On the
; JP2 that is the selfie camera's 3264x2448 alone, of every size of the three
; cameras. Tried on the phone (14 Nov 2026): the selfie's viewfinder no longer
; lags. 0 = as before (the in-between stream).
;                                               values: 0, 1            default 1
jpgYuvFromLargestStream=1
; viewfinderYuv: how the viewfinder's frames come from the engine. 1: as YUV
; (I420), turned into colour by the phone's GPU -- half the bytes through the
; pipe and no conversion on the camera's thread (0.3.11). 0: as RGB, converted
; by the engine, as up to 0.3.9: to compare the two (CPU, frames per second,
; the detailed log's "vfpace" line). Applied when this file is saved.
;                                               values: 0, 1            default 1
viewfinderYuv=1
; viewfinderZeroCopy (branch zero_copy): the viewfinder's frames stay in the
; camera's buffers, drawn by the GPU as they are; only the buffers' ids go
; through the pipe (with the zebra or the peaking on, also their values per
; 2x2 pixels, worked out by the engine). Falls back to viewfinderYuv by
; itself if anything fails (the log says "# zero copy: ..."). 0: off.
; Applied when this file is saved.            values: 0, 1      default 1
viewfinderZeroCopy=1
; aidsEvery: with zero copy, the zebra and the peaking are worked out by the
; engine on one frame in N (the viewfinder itself keeps every frame): 1 =
; every frame (30 a second), 2 = 15, 3 = 10, 4 = 7.5 -- less CPU and battery,
; the aids lag the picture a little when the phone moves. Applied when this
; file is saved.                              values: 1 to 4    default 2
aidsEvery=2
; aidsGpu: with zero copy, the zebra and the peaking drawn by the GPU from
; the engine's values (1), or as an image the app builds each time (0: to
; compare; the RAW zebra is always the latter). Applied when this file is
; saved.                                      values: 0, 1      default 1
aidsGpu=1
; screenOnMinutes: the display kept on while the viewfinder runs, up to N
; minutes after the last touch; 0 = the system's own delay. Applied when
; this file is saved.                         values: 0 to 60   default 5
screenOnMinutes=5
; statsLog: every N seconds, a "# stats" line in the log: the viewfinder's
; mode and fps, CPU (100% = one core, as top), RSS, peak RSS and threads of
; the app and the engine, the system's CPU, the battery (current, voltage,
; charge, charging or not; unplug the phone to compare consumption). The
; first line after an engine starts has no engine CPU yet ("-").
; statsLog, viewfinderZeroCopy and viewfinderYuv apply as soon as this file
; is saved ("# conf changed: ..." in the log).
;                                             values: 0 (off) to 3600  default 0
statsLog=0
; vfBuffers: the camera buffers the viewfinder rotates through (the app may
; hold all but two). More smooth out a late frame, each costs one frame of
; memory (1.8 MB at 1280x960). Read when an engine starts.
;                                             values: 4 to 10   default 6
vfBuffers=6
; hwProbe (branch zero_copy, a test): the engine sends its next N viewfinder
; buffers to the app to be imported without a copy (eglHybrisCreateRemoteBuffer);
; the log says what worked, a picture that came through is saved beside it
; (hwprobe-*.png). The viewfinder is unchanged. Read when an engine starts.
;                                               values: 0 (off) to 20   default 0
hwProbe=0
; hwProbeGpuUsage: with hwProbe, the viewfinder's buffers allocated for GPU
; sampling too (AImageReader_newWithUsage).    values: 0, 1            default 0
hwProbeGpuUsage=0
; snap (in TYPE): the camera driver's own JPEG at a small size, for utility
; shots (a receipt, a sign), noise reduction and sharpening HQ. Its size, as
; WIDTHxHEIGHT among the camera's JPEG sizes ("" = the largest 4:3 size of
; at most 5 megapixels: 2592x1944 on the JP2).
;                                               e.g. 3264x2448          default ""
snapSize=
; Stacks, brackets and bursts use the HAL JPEG and its settings below. On a
; phone whose session cannot hold the YUV stream (exclusive streams), JPG is
; the HAL JPEG.
; The HAL JPEG's noise reduction.               values: auto, default, off, fast, hq, minimal   default auto
; auto: hq where the session cannot hold RAWfish-ir's YUV stream (a device
; profile's "streams": "exclusive"), whose JPG is the camera's JPEG; off elsewhere.
halJpegNoise=auto
; The HAL JPEG's sharpening.                    values: default, off, fast, hq            default hq
halJpegSharpen=hq
; The viewfinder's noise reduction (the HAL's).  values: default, off, fast, hq, minimal   default hq
viewfinderNoise=hq
; The viewfinder's sharpening (the HAL's).      values: default, off, fast, hq            default hq
viewfinderSharpen=hq
; Σ stacks: 1 = the stack's own frames; 2 or 4 = that many times more frames,
; divided out (less noise, 2x or 4x the time).  values: 1, 2, 4         default 1
stackDenoise=1

; --- Focus peaking and zebra (no longer in the menu) -----------------------
; A change in % applied to the device's own thresholds (override-hal.json:
; peak_edge, zebra_jpeg, zebra_raw). Negative = more peaking / zebra appears
; earlier; positive = less / later. In raw the zebra is the RAW's measured
; clipping: the tweak scales the striped share.  values: -30, 0, 30      default 0
peakTweak=0
zebraTweak=0

; --- White balance (the deck's ± and readouts) ------------------------------
; Warmth shift from the white in force, in steps of 5 % on red/blue
; (+ warmer).                                   range -20..20           default 0
wbShift=0
; Tint shift, % of green (- greener, + magenta). range -100..100        default 0
tint=0
; A white measured on a neutral object (the 2 s press on a readout): gains
; "R,Ge,Go,B"; "" = none. At start it is kept only if "Keep previous manual WB"
; is tapped.                                    e.g. 1.8868,1,1,1.4961  default ""
wbFixed=
; Size of one press of the warmth button, in 5 % units.   range 1..4   default 1
fineWarmthStep=1
; Size of one press of the tint button, in % of green.    range 1..25  default 5
fineTintStep=5

; --- Lens shading (vignetting) in the DNG -------------------------------------
; When a measured calibration exists for the phone (one is shipped for the
; Jolla Phone 2), each DNG gets a gain map composed for its own lens position
; and light; these three set how it is applied (darktable applies it).
; Pivot: 0 = only brighten the edges, 100 = only darken towards the darkest
; corner; in between, both. darktable clips values pushed above white, so a
; pivot keeps bright edges from clipping (raise the exposure in darktable).
;                                               range 0..100            default 50
shadingPivot=50
; How much of the correction is applied.        range 0..100            default 100
shadingStrength=100
; The largest gain allowed (more amplifies the corners' noise).
;                                               range 1..8              default 5
shadingMaxGain=5

; --- Σ (stacked long exposures) ------------------------------------------------
; Target frame rate of the Σ viewfinder: one frame of the stack's exposure, as
; short as this allows, the ISO raised to match (slower when the maximum ISO
; is reached).                                  range 1..30 frames/s    default 10
sigmaPreviewFps=10
; Measured by the app after each stack (time the camera adds between
; sub-frames); used for the time estimate under the wheel. Leave it.
;                                               range 0..5000 ms        default 200
frameLatencyMs=200

; --- Kept for "Start in manual focus and exposure" --------------------------
; Saved when the app goes to the background or closes; leave them (absent
; from a new file: the start then takes the automatic values).
; Focus distance in diopters (1/metres; 0 = infinity).   range 0..10
lastFocusD=1
; ISO and shutter (nanoseconds; beyond 500000000 a Σ stack).
lastIso=100
lastShutterNs=16666667
; The level's zero, recorded by holding "level" with the phone upright
; (degrees; empty or absent = the sensor's own zero).
; levelRoll0=0.00
; levelPitch0=0.00
