[Desktop Entry]
Type=Application
NoDisplay=true
Name=RAWfish
Icon=rawfish-sfos
Exec=/usr/bin/invoker --type=silica-media,silica-qt5 -A -- /usr/bin/rawfish
Comment=RAWfish
X-Maemo-Service=com.rawfish.camera
X-Maemo-Method=com.rawfish.camera.ui.showViewfinder
