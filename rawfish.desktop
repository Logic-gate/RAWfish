[Desktop Entry]
Type=Application
Name=RAWfish
Icon=rawfish-sfos
Exec=/usr/bin/rawfish
Comment=RAWfish

[X-Sailjail]
ApplicationName=rawfish
OrganizationName=com.rawfish
DataDirectory=rawfish
Permissions=Camera;Audio;Microphone;Pictures;Videos;MediaIndexing;Location;Privileged;Ambience;RemovableMedia
