####### Compile

camera.o: camera.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o camera.o camera.cpp

####### Install

install_target: first FORCE
	@test -d $(INSTALL_ROOT)/usr/bin || mkdir -p $(INSTALL_ROOT)/usr/bin
	-$(INSTALL_PROGRAM) $(QMAKE_TARGET) $(INSTALL_ROOT)/usr/bin/$(QMAKE_TARGET)
	-$(STRIP) $(INSTALL_ROOT)/usr/bin/$(QMAKE_TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) $(INSTALL_ROOT)/usr/bin/$(QMAKE_TARGET)
	-$(DEL_DIR) $(INSTALL_ROOT)/usr/bin/ 


install_desktop: first FORCE
	@test -d $(INSTALL_ROOT)/usr/share/applications || mkdir -p $(INSTALL_ROOT)/usr/share/applications
	-$(INSTALL_FILE) /home/mad-dev/Projects/jolla-camera2/jolla-camera/rawfish.desktop $(INSTALL_ROOT)/usr/share/applications/

uninstall_desktop: FORCE
	-$(DEL_FILE) -r $(INSTALL_ROOT)/usr/share/applications/rawfish.desktop
	-$(DEL_DIR) $(INSTALL_ROOT)/usr/share/applications/ 


install_icons: first FORCE
	@test -d $(INSTALL_ROOT)/usr/share/icons/hicolor/86x86/apps || mkdir -p $(INSTALL_ROOT)/usr/share/icons/hicolor/86x86/apps
	-$(INSTALL_FILE) /home/mad-dev/Projects/jolla-camera2/jolla-camera/icons/rawfish-sfos.png $(INSTALL_ROOT)/usr/share/icons/hicolor/86x86/apps/

uninstall_icons: FORCE
	-$(DEL_FILE) -r $(INSTALL_ROOT)/usr/share/icons/hicolor/86x86/apps/rawfish-sfos.png
	-$(DEL_DIR) $(INSTALL_ROOT)/usr/share/icons/hicolor/86x86/apps/ 


install_qml: first FORCE
	@test -d $(INSTALL_ROOT)/usr/share/rawfish || mkdir -p $(INSTALL_ROOT)/usr/share/rawfish
	-$(INSTALL_FILE) /home/mad-dev/Projects/jolla-camera2/jolla-camera/camera.qml $(INSTALL_ROOT)/usr/share/rawfish/
	-$(INSTALL_DIR) /home/mad-dev/Projects/jolla-camera2/jolla-camera/cover $(INSTALL_ROOT)/usr/share/rawfish/
	-$(INSTALL_DIR) /home/mad-dev/Projects/jolla-camera2/jolla-camera/pages $(INSTALL_ROOT)/usr/share/rawfish/

uninstall_qml: FORCE
	-$(DEL_FILE) -r $(INSTALL_ROOT)/usr/share/rawfish/pages
	-$(DEL_FILE) -r $(INSTALL_ROOT)/usr/share/rawfish/cover
	-$(DEL_FILE) -r $(INSTALL_ROOT)/usr/share/rawfish/camera.qml
	-$(DEL_DIR) $(INSTALL_ROOT)/usr/share/rawfish/ 


install_service: first FORCE
	@test -d $(INSTALL_ROOT)/usr/share/dbus-1/services || mkdir -p $(INSTALL_ROOT)/usr/share/dbus-1/services
	-$(INSTALL_FILE) /home/mad-dev/Projects/jolla-camera2/jolla-camera/com.rawfish.camera.service $(INSTALL_ROOT)/usr/share/dbus-1/services/

uninstall_service: FORCE
	-$(DEL_FILE) -r $(INSTALL_ROOT)/usr/share/dbus-1/services/com.rawfish.camera.service
	-$(DEL_DIR) $(INSTALL_ROOT)/usr/share/dbus-1/services/ 


install_schema: first FORCE
	@test -d $(INSTALL_ROOT)/etc/dconf/db/vendor.d/ || mkdir -p $(INSTALL_ROOT)/etc/dconf/db/vendor.d/
	-$(INSTALL_FILE) /home/mad-dev/Projects/jolla-camera2/jolla-camera/dconf/00-rawfish.txt $(INSTALL_ROOT)/etc/dconf/db/vendor.d/

